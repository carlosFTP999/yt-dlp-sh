  local outdir
  outdir=$(ask "Directorio de salida" "$OUTDIR")

  # Confirmación con resumen
  print_header "CONFIRMACIÓN — Video"
  printf "  URL:        %s\n" "$url"
  printf "  Salida:     %s\n" "$outdir"
  printf "  Preset:     %s (-S \"res,br\")\n" "$PRESET"
  printf "  Formato:    Contenedor original (webm/mkv/mp4...)\n"
  printf "  Subs:       %s (embed)\n" "$SUB_LANGS"
  printf "  SponsorBlock: mark all + remove %s\n" "$SPONSORBLOCK_REMOVE"
  printf "  Archive:    ✓\n"
