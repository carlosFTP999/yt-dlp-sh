init_config_dirs() {
  mkdir -p "$CONFIG_DIR"
  # El directorio de salida debe existir para que df pueda medir el espacio
  # (si no existe, el check de disco no puede informar nada)
  mkdir -p "$OUTDIR" 2>/dev/null || true
  [[ -f "$CONFIG_FILE" ]] || touch "$CONFIG_FILE"
  [[ -f "$ARCHIVE_FILE" ]] || touch "$ARCHIVE_FILE"
  [[ -f "$HISTORY_FILE" ]] || touch "$HISTORY_FILE"
  [[ -f "$QUEUE_FILE" ]] || touch "$QUEUE_FILE"
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    [[ -z "$key" ]] && continue
    [[ "$key" =~ ^# ]] && continue  # comentarios
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue  # validar key
    # Solo keys conocidas en CONFIG_DEFAULTS
    [[ -v CONFIG_DEFAULTS["$key"] ]] || continue
    # Exportar para subprocessos
    export "$key"="$value"
    # Setear variable global (indirect expansion)
    printf -v "$key" '%s' "$value"
  done < "$CONFIG_FILE"
}

# Guardar config (atómico: temp + mv)
save_config() {
  local tmp
  tmp=$(mktemp "${CONFIG_FILE}.XXXXXX") || die "No se pudo crear temp file"
  {
    echo "# ytdl-sh config — $(date -Iseconds)"
    for key in "${!CONFIG_DEFAULTS[@]}"; do
      local val="${!key}"  # indirect expansion
      printf '%s=%s\n' "$key" "$val"
    done
  } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  ok "Configuración guardada en $CONFIG_FILE"
}

# ──────────────────────────────────────────────────────────────────────
# T7: JSONL HELPERS — Pure bash JSON parsing (sin jq)
# ──────────────────────────────────────────────────────────────────────

# Escapar string para JSON (básico: \, ", newline, tab, carriage return)
json_escape() {
  local str="$1"
  str="${str//\\/\\\\}"  # \ → \\
  str="${str//\"/\\\"}"  # " → \"
  str="${str//$'\n'/\\n}" # newline → \n
  str="${str//$'\t'/\\t}" # tab → \t
  str="${str//$'\r'/\\r}" # carriage return → \r
  printf '%s' "$str"
}

# Validar línea JSONL básica (sin jq)
# Recorre la línea ignorando caracteres escapados dentro de strings,
# para no contar comillas/llaves que son parte del contenido.
# Retorna 0 si parece JSON válido, 1 si no
is_valid_json() {
  local line="$1"
  [[ -z "$line" ]] && return 1
  # Debe empezar con { y terminar con }
  [[ "$line" == "{"*"}" ]] || return 1

  local i ch len=${#line}
  local depth=0 in_string=0
  for ((i = 0; i < len; i++)); do
    ch="${line:i:1}"
    if (( in_string )); then
      if [[ "$ch" == '\' ]]; then
        i=$((i + 1))  # saltar el carácter escapado
      elif [[ "$ch" == '"' ]]; then
        in_string=0
      fi
      continue
    fi
    case "$ch" in
      '"') in_string=1 ;;
      '{') depth=$((depth + 1)) ;;
      '}') depth=$((depth - 1)); if (( depth < 0 )); then return 1; fi ;;
    esac
  done

  (( depth == 0 )) || return 1
  (( in_string == 0 )) || return 1
  return 0
}

# Extraer valor literal de campo JSON (raw: con quotes si es string)
# Soporta strings con escapes, objetos y arrays anidados (balanceo de llaves).
# Uso: json_get_raw "$line" "options"
json_get_raw() {
  local json="$1"
  local key="$2"
  local needle="\"$key\""

  [[ "$json" == *"$needle"* ]] || return 1

  # Prefijo hasta la primera ocurrencia de la key
  local prefix="${json%%"$needle"*}"
  # Resto tras la key
  local rest="${json:${#prefix}+${#needle}}"
  # Quitar separador ':' y whitespace inicial
  rest="${rest#*:}"
  rest="${rest#"${rest%%[![:space:]]*}"}"

  local first="${rest:0:1}"
  local out="" i ch depth

  case "$first" in
    '"')
      # String: avanzar hasta el quote de cierre (respetando escapes)
      for ((i = 1; i < ${#rest}; i++)); do
        ch="${rest:i:1}"
        if [[ "$ch" == '\' ]]; then
          out+="$ch${rest:i+1:1}"
          i=$((i + 1))
          continue
        fi
        [[ "$ch" == '"' ]] && break
        out+="$ch"
      done
      printf '"%s"' "$out"
      ;;
    '{'|'[')
      # Objeto/array: balancear llaves y corchetes
      depth=0
      for ((i = 0; i < ${#rest}; i++)); do
        ch="${rest:i:1}"
        out+="$ch"
        if [[ "$ch" == '{' || "$ch" == '[' ]]; then
          depth=$((depth + 1))
        elif [[ "$ch" == '}' || "$ch" == ']' ]]; then
          depth=$((depth - 1))
          if (( depth == 0 )); then break; fi
        fi
      done
      printf '%s' "$out"
      ;;
    *)
      # Number, bool o null: hasta la primera coma o llave de cierre
      out="${rest%%,*}"
      out="${out%%\}*}"
      printf '%s' "$out"
      ;;
  esac
}

# Extraer valor de campo JSON "cooked": strings sin quotes y con escapes resueltos
# Uso: json_get "$line" "id"
json_get() {
  local raw
  raw=$(json_get_raw "$1" "$2") || return 1
  if [[ "$raw" == '"'*'"' ]]; then
    local inner="${raw:1:${#raw}-2}"
    inner="${inner//\\\"/\"}"
    inner="${inner//\\\\/\\}"
    inner="${inner//\\n/$'\n'}"
    inner="${inner//\\t/$'\t'}"
    inner="${inner//\\r/$'\r'}"
    printf '%s' "$inner"
  else
    printf '%s' "$raw"
  fi
}

# Construir JSON para queue item
# Uso: json_build_queue_item "id" "url" "mode" "preset" '{"start":"1","end":"50"}' "status" "created" ["started"] ["finished"] ["error"]
json_build_queue_item() {
  local id="$1" url="$2" mode="$3" preset="$4" options="$5" status="$6" created="$7" started="${8:-}" finished="${9:-}" error="${10:-}"
  local item
  item=$(printf '{"id":"%s","url":"%s","mode":"%s","preset":"%s","options":%s,"status":"%s"' \
    "$(json_escape "$id")" \
    "$(json_escape "$url")" \
    "$(json_escape "$mode")" \
    "$(json_escape "$preset")" \
    "$options" \
    "$(json_escape "$status")")
  [[ -n "$created" ]] && item="${item},\"created\":\"$(json_escape "$created")\""
  [[ -n "$started" ]] && item="${item},\"started\":\"$(json_escape "$started")\""
  [[ -n "$finished" ]] && item="${item},\"finished\":\"$(json_escape "$finished")\""
  [[ -n "$error" ]] && item="${item},\"error\":\"$(json_escape "$error")\""
  item="${item}}"
  printf '%s' "$item"
}

