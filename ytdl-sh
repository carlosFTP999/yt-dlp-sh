settings_menu() {
  while true; do
    print_header "AJUSTES"
    # Mostrar valores actuales
    for key in "${!CONFIG_DEFAULTS[@]}"; do
      printf "  %s=%s\n" "$key" "${!key}"
    done
    echo
    local choice
    choice=$(choose "Selecciona opción a editar" \
      "OUTDIR"        "Directorio base de salida" \
      "PRESET"        "Preset de calidad (maxima/equilibrado/compatibilidad/minimo/av1opus/custom)" \
      "PARALLEL"      "Jobs paralelos en queue (1-8)" \
      "SUB_LANGS"     "Idiomas subtítulos (coma-separado, ej: es,en,pt)" \
      "SPONSORBLOCK_REMOVE" "Categorías a remover (coma-separado)" \
      "PROXY"         "Proxy HTTP/SOCKS (ej: socks5://127.0.0.1:9050)" \
      "COOKIES_BROWSER" "Browser para cookies (chrome/firefox/edge/brave/opera/vivaldi)" \
      "RATE_LIMIT"    "Rate limit (ej: 1M, 500K, vacío=sin límite)" \
      "FORCE_IPV4"    "Forzar IPv4 (true/false)" \
      "YT_PLAYER_CLIENT" "YouTube player client (android/web/mweb/tv_embed)" \
      "NOTIFY_CMD"    "Comando notificación custom (ej: notify-send 'title' 'body')" \
      "save"          "Guardar y volver" \
      "reset"         "Restaurar defaults" \
      "back"          "Volver sin guardar")
    
    case "$choice" in
      save) save_config; return ;;
      reset) 
        if confirm "¿Restaurar TODOS los defaults?"; then
          for key in "${!CONFIG_DEFAULTS[@]}"; do
            printf -v "$key" '%s' "${CONFIG_DEFAULTS[$key]}"
            export "$key"
          done
          ok "Defaults restaurados"
        fi
        ;;
      back) return ;;
      *) 
        local new_val
        new_val=$(ask "Nuevo valor para $choice" "${!choice}")
        printf -v "$choice" '%s' "$new_val"
        export "$choice"
        ok "$choice actualizado (usa 'Guardar' para persistir)"
        ;;
    esac
  done
}

