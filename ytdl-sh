# ──────────────────────────────────────────────────────────────────────
# UI HELPERS — Pure bash ANSI (cero deps)
# ──────────────────────────────────────────────────────────────────────

# Detectar capacidades de terminal
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  HAS_TPUT=1
  readonly BOLD="$(tput bold 2>/dev/null || echo '')"
  readonly DIM="$(tput dim 2>/dev/null || echo '')"
  readonly RED="$(tput setaf 1 2>/dev/null || echo '')"
  readonly GREEN="$(tput setaf 2 2>/dev/null || echo '')"
  readonly YELLOW="$(tput setaf 3 2>/dev/null || echo '')"
  readonly BLUE="$(tput setaf 4 2>/dev/null || echo '')"
  readonly CYAN="$(tput setaf 6 2>/dev/null || echo '')"
  readonly RESET="$(tput sgr0 2>/dev/null || echo '')"
  readonly CLEAR_LINE="$(tput el 2>/dev/null || echo '')"
else
  HAS_TPUT=0
  readonly BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" CYAN="" RESET="" CLEAR_LINE=""
fi

# Helpers de salida
die() { printf "%b\n" "${RED}✘${RESET} $*" >&2; exit 1; }
ok()   { printf "%b\n" "${GREEN}✔${RESET} $*"; }
info() { printf "%b\n" "${BLUE}ℹ${RESET} $*"; }
warn() { printf "%b\n" "${YELLOW}⚠${RESET} $*"; }
dim()  { printf "%b\n" "${DIM}$*${RESET}"; }

# Header visual
print_header() {
  local title="$1"
  local width=60
  printf "\n%b%*s%b\n" "${BOLD}${CYAN}" "$width" "" "${RESET}"
  printf "%b %-*s %b\n" "${BOLD}${CYAN}" "$((width - 2))" "$title" "${RESET}"
  printf "%b%*s%b\n\n" "${BOLD}${CYAN}" "$width" "" "${RESET}"
}

# Menú navegable con flechas (ANSI)
# Uso: choose "Prompt" "opt1" "desc1" "opt2" "desc2" ...
# Retorna: option seleccionada (stdout)
choose() {
  local prompt="$1"; shift
  local -a opts=("$@")
  local -i n_choices=$(( ${#opts[@]} / 2 ))
  local -i sel=0
  local key

  # Ocultar cursor. A stderr: tput escribe a stdout y contaminaría el
  # valor que choose() devuelve (el menú se invoca como $(choose ...)).
  [[ $HAS_TPUT -eq 1 ]] && tput civis >&2 2>/dev/null

  # IMPORTANTE: todo lo visual va a stderr.
  # choose() se invoca como `choice=$(choose ...)`: si el menú se imprimiera
  # a stdout, el command substitution lo capturaría y el usuario no vería
  # NADA del menú. Solo el valor seleccionado se escribe a stdout.
  while true; do
    clear >&2
    print_header "$prompt" >&2
    for ((i=0; i<${#opts[@]}; i+=2)); do
      local idx=$((i/2))
      if (( idx == sel )); then
        printf "  ${CYAN}▸ %s${RESET} — %s\n" "${opts[i]}" "${opts[i+1]}" >&2
      else
        printf "    %s — %s\n" "${opts[i]}" "${opts[i+1]}" >&2
      fi
    done
    printf "\n  ${DIM}↑/↓ navegar · Enter seleccionar · Esc cancelar${RESET}\n" >&2

    IFS= read -rsn1 key
    case "$key" in
      $'\x1b')
        # Leer la secuencia de escape COMPLETA de una vez (2 bytes: '[' + letra).
        # Con dos reads separados el byte '[' se pierde entre ellos y las
        # flechas dejan de funcionar.
        local rest=""
        IFS= read -rsn2 -t 0.1 rest || true
        if [[ -z "$rest" ]]; then
          # ESC presionado solo → cancelar
          [[ $HAS_TPUT -eq 1 ]] && tput cnorm >&2 2>/dev/null
          return 1
        fi
        case "$rest" in
          '[A') if (( sel > 0 )); then sel=$((sel - 1)); fi ;;
          '[B') if (( sel < n_choices - 1 )); then sel=$((sel + 1)); fi ;;
        esac
        ;;
      '') # Enter
        [[ $HAS_TPUT -eq 1 ]] && tput cnorm >&2 2>/dev/null
        printf '%s' "${opts[sel*2]}"
        return 0
        ;;
      $'\x03') # Ctrl+C
        [[ $HAS_TPUT -eq 1 ]] && tput cnorm >&2 2>/dev/null
        die "Cancelado por usuario"
        ;;
    esac
  done
}

# Input libre con prompt
# Uso: ask "Prompt" [default]
# Retorna: input (stdout)
ask() {
  local prompt="$1"
  local default="${2:-}"
  local input

  if [[ -n "$default" ]]; then
    read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[$default]${RESET} ")" input
    printf '%s' "${input:-$default}"
  else
    read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ")" input
    printf '%s' "$input"
  fi
}

# Confirmación sí/no
# Uso: confirm "Prompt" [default_y/n]
# Retorna: 0=sí, 1=no
confirm() {
  local prompt="$1"
  local default="${2:-y}"
  local yn

  while true; do
    if [[ "$default" == "y" ]]; then
      read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[Y/n]${RESET} ")" yn
      yn="${yn:-y}"
    else
      read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[y/N]${RESET} ")" yn
      yn="${yn:-n}"
    fi
    case "${yn,,}" in
      y|yes|s|si|sí) return 0 ;;
      n|no) return 1 ;;
      *) warn "Respuesta inválida: y/sí o n/no" ;;
    esac
  done
}

# ──────────────────────────────────────────────────────────────────────
# T9: DETECCIÓN DE URL — tipo de contenido + plataforma (bash puro, offline)
# ──────────────────────────────────────────────────────────────────────

# Extrae el host de una URL (sin esquema, sin userinfo, sin www, minúsculas)
url_host() {
  local host="$1"
  host="${host#*://}"      # quita esquema
  host="${host%%/*}"      # quita path
  host="${host%%\?*}"     # quita query
  host="${host#*@}"       # quita userinfo
  host="${host,,}"        # minúsculas
  host="${host#www.}"     # quita www.
  printf '%s' "$host"
}

# Extrae el path de una URL (sin query ni fragment)
url_path() {
  local path="$1"
  path="${path#*://}"     # quita esquema
  path="${path#*${path%%/*}}"  # quita host
  path="${path%%\?*}"     # quita query
  path="${path%%#*}"      # quita fragment
  printf '%s' "$path"
}

# Extrae el ID de playlist (list=...) de una URL
# Retorna: ID o cadena vacía
extract_playlist_id() {
  local url="$1"
  if [[ "$url" =~ list=([A-Za-z0-9_-]+) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

# Detecta tipo de contenido y plataforma de una URL
# Retorna: "TIPO PLATAFORMA"  (ej: "playlist youtube")
#
# TIPO: video | video_in_playlist | playlist | shorts | live | channel
#       | uploads | audio | unknown
# PLATAFORMA: youtube | tiktok | vimeo | twitter | ... | <dominio>
#
# No hace red: parseo puro de patrones (instantáneo, offline).
detect_url() {
  local url="$1"
  local host path tipo="video" plataforma="generic"

  host=$(url_host "$url")
  path=$(url_path "$url")

  # ── Plataforma ──
  case "$host" in
    youtube.com|youtu.be|m.youtube.com|music.youtube.com|gaming.youtube.com|nocookie.com)
      plataforma="youtube" ;;
    tiktok.com)              plataforma="tiktok" ;;
    twitter.com|x.com)       plataforma="twitter" ;;
    instagram.com)            plataforma="instagram" ;;
    facebook.com|fb.watch)   plataforma="facebook" ;;
    vimeo.com)               plataforma="vimeo" ;;
    twitch.tv)               plataforma="twitch" ;;
    reddit.com|redd.it)      plataforma="reddit" ;;
    soundcloud.com)          plataforma="soundcloud" ;;
    bandcamp.com)            plataforma="bandcamp" ;;
    bilibili.com|b23.tv)     plataforma="bilibili" ;;
    dailymotion.com|dai.ly)  plataforma="dailymotion" ;;
    odysee.com)              plataforma="odysee" ;;
    rumble.com)              plataforma="rumble" ;;
    linkedin.com)            plataforma="linkedin" ;;
    vk.com)                  plataforma="vk" ;;
    *.youtube.com)           plataforma="youtube" ;;
    "")                      plataforma="desconocida" ;;
    *)                       plataforma="$host" ;;
  esac

  # ── Tipo ──
  case "$plataforma" in
    youtube)
      if [[ "$path" == *"/playlist"* ]]; then
        # list=UU/LL/FL → lista de uploads del propio canal
        local plid
        plid=$(extract_playlist_id "$url")
        case "$plid" in
          UU*|LL*|FL*) tipo="uploads" ;;
          *)            tipo="playlist" ;;
        esac
      elif [[ "$path" == *"/shorts/"* ]]; then
        tipo="shorts"
      elif [[ "$path" == *"/live/"* ]]; then
        tipo="live"
      elif [[ "$path" == *"/embed/"* ]]; then
        tipo="video"
      elif [[ "$path" == *"/watch"* || "$host" == "youtu.be" ]]; then
        if [[ "$url" == *"list="* ]]; then
          tipo="video_in_playlist"   # ambiguo: video O playlist completa
        else
          tipo="video"
        fi
      elif [[ "$path" == "/@"* || "$path" == "/c/"* || "$path" == "/channel/"* \
              || "$path" == "/user/"* || "$path" == "/u/"* ]]; then
        tipo="channel"
      fi
      ;;
    twitch)
      if [[ "$path" == *"/videos"* || "$path" == *"/streams"* || "$path" == "/popout/"* ]]; then
        tipo="channel"
      fi
      ;;
    soundcloud|bandcamp)
      tipo="audio"
      ;;
  esac

  # Newline final: read devuelve 1 al llegar a EOF sin delimitador
  # (con set -e eso abortaría el script)
  printf '%s %s\n' "$tipo" "$plataforma"
}

# Mapea el tipo detectado al modo de descarga correspondiente
type_to_mode() {
  case "$1" in
    playlist|video_in_playlist) printf 'playlist' ;;
    channel|uploads)            printf 'channel' ;;
    shorts|live|video)          printf 'video' ;;
    audio)                      printf 'audio' ;;
    *)                          printf 'video' ;;
  esac
}

# Etiqueta legible del tipo detectado
type_label() {
  case "$1" in
    video)             printf 'Video' ;;
    video_in_playlist) printf 'Video dentro de una playlist' ;;
    playlist)          printf 'Playlist' ;;
    shorts)            printf 'Short' ;;
    live)              printf 'Directo (live)' ;;
    channel)           printf 'Canal' ;;
    uploads)           printf 'Uploads de canal' ;;
    audio)             printf 'Audio' ;;
    unknown)           printf 'Contenido' ;;
    *)                 printf 'Video' ;;
  esac
}

# Banner de detección (informativo, no bloqueante)
detect_banner() {
  local url="$1" tipo="$2" plataforma="$3"
  printf '  %s🔍 %s · %s%s\n' "$CYAN" "$plataforma" "$(type_label "$tipo")" "$RESET"
}

# ──────────────────────────────────────────────────────────────────────
# T10: VALIDACIÓN DE URL + DEEP CDN CHECK CACHEADO
# ──────────────────────────────────────────────────────────────────────

# ── Cache del CDN ──
readonly CDN_CACHE_FILE="$CONFIG_DIR/.cdn_cache"
readonly CDN_CACHE_TTL=21600   # 6 horas en segundos

# Lee el cache del CDN. Retorna "timestamp host status" o falla si no existe.
cdn_cache_read() {
  [[ -f "$CDN_CACHE_FILE" ]] || return 1
  local line
  line=$(head -1 "$CDN_CACHE_FILE" 2>/dev/null) || return 1
  [[ -n "$line" ]] || return 1
  printf '%s' "$line"
}

# Escribe el cache de forma atómica (temp + mv)
cdn_cache_write() {
  local host="$1" status="$2"
  local tmp
  tmp=$(mktemp "${CDN_CACHE_FILE}.XXXXXX") || return 1
  printf '%s %s %s\n' "$(date +%s)" "$host" "$status" > "$tmp" && mv "$tmp" "$CDN_CACHE_FILE"
}

# Valida el cache: existe, es un éxito, y no venció el TTL.
# Retorna el host cacheado o falla.
cdn_cache_valid() {
  local line ts host status now
  line=$(cdn_cache_read) || return 1
  IFS=' ' read -r ts host status <<<"$line" || true
  [[ -n "$ts" && -n "$host" && "$status" == "ok" ]] || return 1
  now=$(date +%s)
  (( now - ts < CDN_CACHE_TTL )) || return 1
  printf '%s' "$host"
  return 0
}

# ── Validación de URL ──

# Extrae un campo "CLAVE:valor" de la salida de yt-dlp --print
# Toma solo la primera línea: los títulos pueden contener saltos de línea
# y los valores pueden contener ":" (ej: "Video: Parte 2")
# Uso: val=$(validate_field "$out" "TITULO")
validate_field() {
  local out="$1" key="$2"
  printf '%s\n' "$out" | sed -n "s/^${key}://p" | head -1 | sed 's/^[[:space:]]*//'
}

# Valida una URL: metadata real (nivel 1)
# Retorna: "TITULO|DURACION|CANTIDAD|EXTRACTOR"
validate_url() {
  local url="$1"
  local tipo
  IFS=' ' read -r tipo _ < <(detect_url "$url") || tipo="video"

  # --flat-playlist evita expandir la lista (rápido).
  # --playlist-items 1 es IMPRESCINDIBLE: sin él, yt-dlp imprime los
  # --print una vez por cada item de la lista.
  local -a args=(--simulate --no-warnings)
  case "$tipo" in
    video|shorts|live) ;;
    *) args+=(--flat-playlist --playlist-items 1) ;;
  esac

  timeout 30 yt-dlp "${args[@]}" \
        --print "TITULO:%(title)s" \
        --print "PLTITULO:%(playlist_title)s" \
        --print "DURACION:%(duration)s" \
        --print "CANTIDAD:%(playlist_count)s" \
        --print "EXTRACTOR:%(extractor_key)s" \
        "$url" 2>&1
}

# Valida que el CDN de una URL específica sea alcanzable (nivel 2)
# Reusa la técnica probada: yt-dlp -g con filtro de protocolo http
# (evita manifests HLS, que no sirven para validar el CDN de video)
validate_url_cdn() {
  local url="$1"
  local tipo
  IFS=' ' read -r tipo _ < <(detect_url "$url") || tipo="video"

  # Para playlists/canales, resolver solo el primer item (si no, yt-dlp
  # resuelve la URL de los 40 videos y tarda mucho más)
  local -a args=(-g -f "bv*[protocol^=http]")
  case "$tipo" in
    video|shorts|live) ;;
    *) args+=(--playlist-items 1) ;;
  esac

  local direct
  direct=$(timeout 30 yt-dlp "${args[@]}" "$url" 2>/dev/null | head -1) || direct=""
  if [[ -z "$direct" ]]; then
    warn "No se pudo resolver la URL directa del video (¿video no disponible?)"
    return 1
  fi

  local host code rc=0
  host=$(printf '%s' "$direct" | sed -E 's#^https://([^/]+)/.*#\1#')
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 15 -r 0-100000 "$direct" 2>/dev/null) || rc=$?

  if (( rc == 0 )) && [[ "$code" =~ ^(200|206) ]]; then
    ok "CDN accesible (http=$code) — $host"
    printf '%s' "$host"
    return 0
  fi

  if (( rc != 0 )); then
    warn "CDN NO accesible — $(http_diagnose "$direct")"
  else
    warn "CDN respondió http=$code (no 200/206)"
  fi
  return 1
}

# Muestra el resumen de validación de una URL
show_validation() {
  local url="$1"
  print_header "VALIDACIÓN — $url"

  info "Consultando metadata (yt-dlp --simulate)..."
  local out rc=0
  out=$(validate_url "$url") || rc=$?

  if (( rc != 0 )); then
    local err
    err=$(printf '%s\n' "$out" | grep -m1 '^ERROR:' | sed 's/^ERROR:[[:space:]]*//')
    [[ -n "$err" ]] || err="no se pudo validar la URL"
    warn "La URL no es válida:"
    printf '     %s\n' "$err"
    echo
    warn "No se puede descargar esto. Verificá el link o la disponibilidad."
    return 1
  fi

  # Extraer campo por campo (sin separadores: los valores pueden contener "|")
  local titulo pltitulo duracion cantidad extractor
  pltitulo=$(validate_field "$out" "PLTITULO")
  titulo=$(validate_field "$out" "TITULO")
  duracion=$(validate_field "$out" "DURACION")
  cantidad=$(validate_field "$out" "CANTIDAD")
  extractor=$(validate_field "$out" "EXTRACTOR")

  # Para playlists/canales, el título de la lista es el relevante
  [[ -z "$pltitulo" || "$pltitulo" == "NA" ]] || titulo="$pltitulo"

  # Los títulos pueden traer saltos de línea: en una línea se lee mejor
  titulo="${titulo//$'\n'/ }"

  [[ -n "$titulo" ]] && printf '  %sTítulo:%s   %s\n' "$BOLD" "$RESET" "$titulo"
  [[ -n "$duracion" && "$duracion" != "NA" ]] && \
    printf '  %sDuración:%s %s\n' "$BOLD" "$RESET" "$(format_duration "$duracion")"
  [[ -n "$cantidad" && "$cantidad" != "NA" && "$cantidad" != "1" ]] && \
    printf '  %sCantidad:%s %s videos\n' "$BOLD" "$RESET" "$cantidad"
  [[ -n "$extractor" ]] && printf '  %sExtractor:%s %s\n' "$BOLD" "$RESET" "$extractor"
  echo

  # Nivel 2: CDN de esta URL específica
  info "Verificando CDN de video (range 100KB, no descarga)..."
  local host rc2=0
  host=$(validate_url_cdn "$url") || rc2=$?

  echo
  if (( rc2 == 0 )); then
    # Cacheamos el éxito: así los próximos arranques no repiten el deep check
    cdn_cache_write "$host" "ok"
    ok "Validación completa: se puede descargar ✓"
  else
    warn "Validación: la URL es correcta pero el CDN no responde."
    warn "  → Si usás proxy corporativo, puede no alcanzar el CDN."
    warn "  → Probá VPN o configurá PROXY en Ajustes."
  fi
  return 0
}

# Convierte segundos a HH:MM:SS
format_duration() {
  local secs="$1"
  [[ "$secs" =~ ^[0-9]+$ ]] || { printf '%s' "$secs"; return; }
  printf '%02d:%02d:%02d' $(( secs / 3600 )) $(( (secs % 3600) / 60 )) $(( secs % 60 ))
}

# ──────────────────────────────────────────────────────────────────────
# STUBS — Para ser implementados en T4, T6, T7
