settings_menu() {
  print_header "AJUSTES (Fase 1 — Solo lugar reservado)"
  info "Configuración persistente se implementa en T6"
  info "Archivo: $CONFIG_FILE"
  info "Formato: key=value (ej: OUTDIR=/ruta, PRESET=maxima)"
  ask "Presiona Enter para volver" "" >/dev/null
}

