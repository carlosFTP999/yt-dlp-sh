# Video de prueba para resolver el CDN real de YouTube.
# Big Buck Bunny — trailer oficial de YouTube, estable y público.
readonly PROBE_VIDEO_URL="https://www.youtube.com/watch?v=aqz-KE-bpKQ"

# Diagnostica por qué falló una petición HTTP
# Uso: reason=$(http_diagnose "$url")
http_diagnose() {
  local url="$1"
  local code rc
  local code rc=0
  # Con set -e, una asignación cuyo comando falla aborta el script:
  # capturamos el código con "|| rc=$?" en vez de "$?" suelto
  code=$(curl -sI -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null) || rc=$?

  if (( rc == 0 )); then
    if [[ "$code" =~ ^[23] ]]; then
      printf 'ok (http=%s)' "$code"
    else
      printf 'http=%s (servidor respondió pero no 2xx/3xx)' "$code"
    fi
    return 0
  fi

  case "$rc" in
    6)  printf 'DNS no resuelve el host' ;;
    7)  printf 'conexión rechazada (¿firewall o proxy?)' ;;
    28) printf 'timeout de 10s (red lenta o proxy saturado)' ;;
    35|51|60) printf 'error SSL/TLS (proxy con intercepción sin CA, o bloqueo)' ;;
    52|56) printf 'respuesta vacía o conexión caída (¿proxy cortando?)' ;;
    *)  printf 'error de red (curl=%s)' "$rc" ;;
  esac
  return 1
}

# Verifica que YouTube responde (metadata de vídeo)
# 2 intentos con 1s de espera: redes/proxies lentos fallan de forma transitoria
check_youtube_reachable() {
  # YT_CHECK_URL permite testear el caso de fallo (host inalcanzable)
  local url="${YT_CHECK_URL:-https://www.youtube.com}"
  local attempt=1 code rc=1

  while (( attempt <= 2 )); do
    # rc debe resetearse en cada intento: si no, un fallo previo
    # invalida el éxito del reintento siguiente
    rc=0
    code=$(curl -sI -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null) || rc=$?
    if (( rc == 0 )) && [[ "$code" =~ ^[23] ]]; then
      ok "YouTube accesible (http=$code)"
      return 0
    fi
    (( attempt < 2 )) && sleep 1
    attempt=$((attempt + 1))
  done

  warn "YouTube NO accesible — $(http_diagnose "$url")"
  return 1
}

# Verifica el espacio disponible en el directorio de salida
# Usa df -Pk (POSIX) en lugar de --output (GNU only) para portabilidad
check_disk_space() {
  local avail_kb=""
  local line
  line=$(df -Pk "$OUTDIR" 2>/dev/null | tail -1) || line=""
  if [[ -n "$line" ]]; then
    # Campos: Filesystem 1024-blocks Used Available Capacity Mounted-on
    # IFS local a espacio: el IFS global del script es $'\n\t' y no separa campos
    local IFS=' '
    read -r _ _ _ avail_kb _ _ <<<"$line"
  fi

  if [[ -z "$avail_kb" ]]; then
    dim "Espacio en disco: no se pudo medir (sigo adelante)"
    return 0
  fi

  if (( avail_kb < 1048576 )); then  # < 1GB
    warn "Espacio en disco < 1GB en $OUTDIR ($(( avail_kb / 1024 ))MB libres)"
    return 1
  fi

  ok "Espacio en disco OK ($(( avail_kb / 1048576 ))GB libres en $OUTDIR)"
  return 0
}

# Test bajo demanda del CDN de video real de YouTube.
# Resuelve una URL de vídeo auténtica con yt-dlp -g y le pide un rango
# pequeño al CDN. Es la única comprobación que refleja de verdad si las
# descargas funcionan (el dominio apex googlevideo.com no es un host válido).
CDN_HOST=""
check_cdn_reachable() {
  print_header "TEST DE CONEXIÓN — CDN DE VIDEO"

  info "Resolviendo URL real de video (yt-dlp -g)..."
  local url host
  url=$(timeout 30 yt-dlp -g -f "bv*" "$PROBE_VIDEO_URL" 2>/dev/null | head -1) || url=""
  if [[ -z "$url" ]]; then
    warn "No se pudo resolver la URL del video de prueba"
    warn "  → YouTube puede estar bloqueado o el extractor falló"
    return 1
  fi

  host=$(printf '%s' "$url" | sed -E 's#^https://([^/]+)/.*#\1#')
  info "Host del CDN: $host"

  # Rango pequeño: suficiente para probar la ruta sin descargar nada pesado
  local code rc
  local rc=0
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 15 -r 0-100000 "$url" 2>/dev/null) || rc=$?

  if (( rc == 0 )) && [[ "$code" =~ ^(200|206) ]]; then
    ok "CDN de video accesible (http=$code) — las descargas deberían funcionar"
    CDN_HOST="$host"
    return 0
  fi

  if (( rc != 0 )); then
    warn "CDN de video NO accesible — $(http_diagnose "$url")"
  else
    warn "CDN de video respondió http=$code (no 200/206)"
  fi
  warn "  → Si usás proxy corporativo: puede no alcanzar el CDN."
  warn "  → Probá VPN, o configurá PROXY en Ajustes."
  return 1
}

preflight_checks() {
  local warn_count=0

  check_youtube_reachable || warn_count=$((warn_count + 1))
  check_disk_space || warn_count=$((warn_count + 1))
  check_cdn_cached || warn_count=$((warn_count + 1))

  if (( warn_count > 0 )); then
    echo
    warn "Se detectaron $warn_count advertencia(s). ¿Continuar de todos modos?"
    confirm "Continuar?" || die "Abortado por usuario"
  fi
}

# Deep check del CDN con cache de 6 horas.
#
# PREFLIGHT_DEEP:
#   auto   (default) — usa el cache si es válido; si no, hace el check y cachea
#   always          — siempre hace el check (ignora el cache)
#   never           — no hace el check
#
# Solo se cachean los ÉXITOS: si el CDN falla (proxy, VPN apagado),
# el siguiente arranque reintenta, así al prender el VPN se recupera al toque.
check_cdn_cached() {
  case "${PREFLIGHT_DEEP:-auto}" in
    never)
      dim "Deep check del CDN: desactivado (PREFLIGHT_DEEP=never)"
      return 0
      ;;
    auto)
      local cached_host
      if cached_host=$(cdn_cache_valid); then
        local line ts
        line=$(cdn_cache_read) || true
        IFS=' ' read -r ts _ _ <<<"$line" || true
        local mins=$(( ( $(date +%s) - ts ) / 60 ))
        ok "CDN de video accesible (cacheado hace ${mins} min): $cached_host"
        return 0
      fi
      info "Verificando CDN de video por primera vez (~9s)..."
      ;;
    always)
      info "Verificando CDN de video (PREFLIGHT_DEEP=always)..."
      ;;
  esac

  if check_cdn_reachable; then
    [[ -n "$CDN_HOST" ]] && cdn_cache_write "$CDN_HOST" "ok"
    return 0
  fi

  # No cacheamos el fallo a propósito: el próximo arranque reintenta
  dim "No se cachea el fallo; se reintentará en el próximo arranque"
  return 1
}

load_queue() {
  QUEUE=()
  [[ -f "$QUEUE_FILE" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if is_valid_json "$line"; then
      QUEUE+=("$line")
    else
      warn "Línea inválida en queue (skip): ${line:0:80}..."
    fi
  done < "$QUEUE_FILE"
}

# Guardar queue (atómico: temp + mv)
save_queue() {
  local tmp
  tmp=$(mktemp "${QUEUE_FILE}.XXXXXX") || die "No se pudo crear temp file"
  printf '%s\n' "${QUEUE[@]}" > "$tmp" && mv "$tmp" "$QUEUE_FILE"
}

trap_cleanup() {
  save_queue
  for dir in "${TEMP_DIRS[@]}"; do
    [[ -d "$dir" ]] && rm -rf "$dir"
  done
  [[ $HAS_TPUT -eq 1 ]] && tput cnorm >&2 2>/dev/null
}

