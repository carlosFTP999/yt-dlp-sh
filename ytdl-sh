init_config_dirs() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$CONFIG_FILE" ]] || touch "$CONFIG_FILE"
  [[ -f "$ARCHIVE_FILE" ]] || touch "$ARCHIVE_FILE"
  [[ -f "$HISTORY_FILE" ]] || touch "$HISTORY_FILE"
  [[ -f "$QUEUE_FILE" ]] || touch "$QUEUE_FILE"
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    [[ -z "$key" ]] && continue
    [[ "$key" =~ ^# ]] && continue  # comentarios
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue  # validar key
    # Solo keys conocidas en CONFIG_DEFAULTS
    [[ -v CONFIG_DEFAULTS["$key"] ]] || continue
    # Exportar para subprocessos
    export "$key"="$value"
    # Setear variable global (indirect expansion)
    printf -v "$key" '%s' "$value"
  done < "$CONFIG_FILE"
}

# Guardar config (atómico: temp + mv)
save_config() {
  local tmp
  tmp=$(mktemp "${CONFIG_FILE}.XXXXXX") || die "No se pudo crear temp file"
  {
    echo "# ytdl-sh config — $(date -Iseconds)"
    for key in "${!CONFIG_DEFAULTS[@]}"; do
      local val="${!key}"  # indirect expansion
      printf '%s=%s\n' "$key" "$val"
    done
  } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  ok "Configuración guardada en $CONFIG_FILE"
}

# ──────────────────────────────────────────────────────────────────────
# T7: JSONL HELPERS — Pure bash JSON parsing (sin jq)
# ──────────────────────────────────────────────────────────────────────

# Escapar string para JSON (básico: \, ", newline, tab, carriage return)
json_escape() {
  local str="$1"
  str="${str//\\/\\\\}"  # \ → \\
  str="${str//\"/\\\"}"  # " → \"
  str="${str//$'\n'/\\n}" # newline → \n
  str="${str//$'\t'/\\t}" # tab → \t
  str="${str//$'\r'/\\r}" # carriage return → \r
  printf '%s' "$str"
}

# Validar línea JSONL básica (sin jq)
# Recorre la línea ignorando caracteres escapados dentro de strings,
# para no contar comillas/llaves que son parte del contenido.
# Retorna 0 si parece JSON válido, 1 si no
is_valid_json() {
  local line="$1"
  [[ -z "$line" ]] && return 1
  # Debe empezar con { y terminar con }
  [[ "$line" == "{"*"}" ]] || return 1

  local i ch len=${#line}
  local depth=0 in_string=0
  for ((i = 0; i < len; i++)); do
    ch="${line:i:1}"
    if (( in_string )); then
      if [[ "$ch" == '\' ]]; then
        i=$((i + 1))  # saltar el carácter escapado
      elif [[ "$ch" == '"' ]]; then
        in_string=0
      fi
      continue
    fi
    case "$ch" in
      '"') in_string=1 ;;
      '{') depth=$((depth + 1)) ;;
      '}') depth=$((depth - 1)); if (( depth < 0 )); then return 1; fi ;;
    esac
  done

  (( depth == 0 )) || return 1
  (( in_string == 0 )) || return 1
  return 0
}

# Extraer valor literal de campo JSON (raw: con quotes si es string)
# Soporta strings con escapes, objetos y arrays anidados (balanceo de llaves).
# Uso: json_get_raw "$line" "options"
json_get_raw() {
  local json="$1"
  local key="$2"
  local needle="\"$key\""

  [[ "$json" == *"$needle"* ]] || return 1

  # Prefijo hasta la primera ocurrencia de la key
  local prefix="${json%%"$needle"*}"
  # Resto tras la key
  local rest="${json:${#prefix}+${#needle}}"
  # Quitar separador ':' y whitespace inicial
  rest="${rest#*:}"
  rest="${rest#"${rest%%[![:space:]]*}"}"

  local first="${rest:0:1}"
  local out="" i ch depth

  case "$first" in
    '"')
      # String: avanzar hasta el quote de cierre (respetando escapes)
      for ((i = 1; i < ${#rest}; i++)); do
        ch="${rest:i:1}"
        if [[ "$ch" == '\' ]]; then
          out+="$ch${rest:i+1:1}"
          i=$((i + 1))
          continue
        fi
        [[ "$ch" == '"' ]] && break
        out+="$ch"
      done
      printf '"%s"' "$out"
      ;;
    '{'|'[')
      # Objeto/array: balancear llaves y corchetes
      depth=0
      for ((i = 0; i < ${#rest}; i++)); do
        ch="${rest:i:1}"
        out+="$ch"
        if [[ "$ch" == '{' || "$ch" == '[' ]]; then
          depth=$((depth + 1))
        elif [[ "$ch" == '}' || "$ch" == ']' ]]; then
          depth=$((depth - 1))
          if (( depth == 0 )); then break; fi
        fi
      done
      printf '%s' "$out"
      ;;
    *)
      # Number, bool o null: hasta la primera coma o llave de cierre
      out="${rest%%,*}"
      out="${out%%\}*}"
      printf '%s' "$out"
      ;;
  esac
}

# Extraer valor de campo JSON "cooked": strings sin quotes y con escapes resueltos
# Uso: json_get "$line" "id"
json_get() {
  local raw
  raw=$(json_get_raw "$1" "$2") || return 1
  if [[ "$raw" == '"'*'"' ]]; then
    local inner="${raw:1:${#raw}-2}"
    inner="${inner//\\\"/\"}"
    inner="${inner//\\\\/\\}"
    inner="${inner//\\n/$'\n'}"
    inner="${inner//\\t/$'\t'}"
    inner="${inner//\\r/$'\r'}"
    printf '%s' "$inner"
  else
    printf '%s' "$raw"
  fi
}

# Construir JSON para queue item
# Uso: json_build_queue_item "id" "url" "mode" "preset" '{"start":"1","end":"50"}' "status" "created" ["started"] ["finished"] ["error"]
json_build_queue_item() {
  local id="$1" url="$2" mode="$3" preset="$4" options="$5" status="$6" created="$7" started="${8:-}" finished="${9:-}" error="${10:-}"
  local item
  item=$(printf '{"id":"%s","url":"%s","mode":"%s","preset":"%s","options":%s,"status":"%s"' \
    "$(json_escape "$id")" \
    "$(json_escape "$url")" \
    "$(json_escape "$mode")" \
    "$(json_escape "$preset")" \
    "$options" \
    "$(json_escape "$status")")
  [[ -n "$created" ]] && item="${item},\"created\":\"$(json_escape "$created")\""
  [[ -n "$started" ]] && item="${item},\"started\":\"$(json_escape "$started")\""
  [[ -n "$finished" ]] && item="${item},\"finished\":\"$(json_escape "$finished")\""
  [[ -n "$error" ]] && item="${item},\"error\":\"$(json_escape "$error")\""
  item="${item}}"
  printf '%s' "$item"
}

# Array para temp dirs (cleanup en trap)
TEMP_DIRS=()

# Registrar temp dir para cleanup automático
register_temp_dir() {
  TEMP_DIRS+=("$1")
}

# ──────────────────────────────────────────────────────────────────────
# CHECK DEPENDENCIES
# ──────────────────────────────────────────────────────────────────────

check_dependencies() {
  # yt-dlp
  command -v yt-dlp >/dev/null || die "yt-dlp no encontrado. Instala: pipx install yt-dlp / brew install yt-dlp / apt install yt-dlp"
  local ytdlp_ver
  ytdlp_ver=$(yt-dlp --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1) || ytdlp_ver=""
  [[ -n "$ytdlp_ver" ]] || die "No se pudo obtener versión de yt-dlp"
  # Comparar versión ≥ 2023.01 (año ≥ 2023)
  local year="${ytdlp_ver%%.*}"
  (( year >= 2023 )) || warn "yt-dlp versión $ytdlp_ver — se recomienda ≥ 2023.01 para -S"

  # ffmpeg
  command -v ffmpeg >/dev/null || die "ffmpeg no encontrado. Instala: apt install ffmpeg / brew install ffmpeg"
  local ffmpeg_ver
  ffmpeg_ver=$(ffmpeg -version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1) || ffmpeg_ver=""
  [[ -n "$ffmpeg_ver" ]] || warn "No se pudo obtener versión de ffmpeg"

  # curl
  command -v curl >/dev/null || die "curl no encontrado. Necesario para validación de red"

  ok "Dependencias OK: yt-dlp $ytdlp_ver, ffmpeg $ffmpeg_ver"
}

# ──────────────────────────────────────────────────────────────────────
# T3: PREFLIGHT CHECKS — Validación real de red y disco
# ──────────────────────────────────────────────────────────────────────

# Video de prueba para resolver el CDN real de YouTube.
# Big Buck Bunny — trailer oficial de YouTube, estable y público.
readonly PROBE_VIDEO_URL="https://www.youtube.com/watch?v=aqz-KE-bpKQ"

# Diagnostica por qué falló una petición HTTP
# Uso: reason=$(http_diagnose "$url")
http_diagnose() {
  local url="$1"
  local code rc
  local code rc=0
  # Con set -e, una asignación cuyo comando falla aborta el script:
  # capturamos el código con "|| rc=$?" en vez de "$?" suelto
  code=$(curl -sI -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null) || rc=$?

  if (( rc == 0 )); then
    if [[ "$code" =~ ^[23] ]]; then
      printf 'ok (http=%s)' "$code"
    else
      printf 'http=%s (servidor respondió pero no 2xx/3xx)' "$code"
    fi
    return 0
  fi

  case "$rc" in
    6)  printf 'DNS no resuelve el host' ;;
    7)  printf 'conexión rechazada (¿firewall o proxy?)' ;;
    28) printf 'timeout de 10s (red lenta o proxy saturado)' ;;
    35|51|60) printf 'error SSL/TLS (proxy con intercepción sin CA, o bloqueo)' ;;
    52|56) printf 'respuesta vacía o conexión caída (¿proxy cortando?)' ;;
    *)  printf 'error de red (curl=%s)' "$rc" ;;
  esac
  return 1
}

# Verifica que YouTube responde (metadata de vídeo)
# 2 intentos con 1s de espera: redes/proxies lentos fallan de forma transitoria
check_youtube_reachable() {
  # YT_CHECK_URL permite testear el caso de fallo (host inalcanzable)
  local url="${YT_CHECK_URL:-https://www.youtube.com}"
  local attempt=1 code rc=1

  while (( attempt <= 2 )); do
    code=$(curl -sI -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null) || rc=$?
    if (( rc == 0 )) && [[ "$code" =~ ^[23] ]]; then
      ok "YouTube accesible (http=$code)"
      return 0
    fi
    (( attempt < 2 )) && sleep 1
    attempt=$((attempt + 1))
  done

  warn "YouTube NO accesible — $(http_diagnose "$url")"
  return 1
}

# Verifica el espacio disponible en el directorio de salida
# Usa df -Pk (POSIX) en lugar de --output (GNU only) para portabilidad
check_disk_space() {
  local avail_kb=""
  local line
  line=$(df -Pk "$OUTDIR" 2>/dev/null | tail -1) || line=""
  if [[ -n "$line" ]]; then
    # Campos: Filesystem 1024-blocks Used Available Capacity Mounted-on
    # IFS local a espacio: el IFS global del script es $'\n\t' y no separa campos
    local IFS=' '
    read -r _ _ _ avail_kb _ _ <<<"$line"
  fi

  if [[ -z "$avail_kb" ]]; then
    dim "Espacio en disco: no se pudo medir (sigo adelante)"
    return 0
  fi

  if (( avail_kb < 1048576 )); then  # < 1GB
    warn "Espacio en disco < 1GB en $OUTDIR ($(( avail_kb / 1024 ))MB libres)"
    return 1
  fi

  ok "Espacio en disco OK ($(( avail_kb / 1048576 ))GB libres en $OUTDIR)"
  return 0
}

# Test bajo demanda del CDN de video real de YouTube.
# Resuelve una URL de vídeo auténtica con yt-dlp -g y le pide un rango
# pequeño al CDN. Es la única comprobación que refleja de verdad si las
# descargas funcionan (el dominio apex googlevideo.com no es un host válido).
check_cdn_reachable() {
  print_header "TEST DE CONEXIÓN — CDN DE VIDEO"

  info "Resolviendo URL real de video (yt-dlp -g)..."
  local url host
  url=$(timeout 30 yt-dlp -g -f "bv*" "$PROBE_VIDEO_URL" 2>/dev/null | head -1) || url=""
  if [[ -z "$url" ]]; then
    warn "No se pudo resolver la URL del video de prueba"
    warn "  → YouTube puede estar bloqueado o el extractor falló"
    return 1
  fi

  host=$(printf '%s' "$url" | sed -E 's#^https://([^/]+)/.*#\1#')
  info "Host del CDN: $host"

  # Rango pequeño: suficiente para probar la ruta sin descargar nada pesado
  local code rc
  local rc=0
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 15 -r 0-100000 "$url" 2>/dev/null) || rc=$?

  if (( rc == 0 )) && [[ "$code" =~ ^(200|206) ]]; then
    ok "CDN de video accesible (http=$code) — las descargas deberían funcionar"
    return 0
  fi

  if (( rc != 0 )); then
    warn "CDN de video NO accesible — $(http_diagnose "$url")"
  else
    warn "CDN de video respondió http=$code (no 200/206)"
  fi
  warn "  → Si usás proxy corporativo: puede no alcanzar el CDN."
  warn "  → Probá VPN, o configurá PROXY en Ajustes."
  return 1
}

preflight_checks() {
  local warn_count=0

  check_youtube_reachable || warn_count=$((warn_count + 1))
  check_disk_space || warn_count=$((warn_count + 1))

  if (( warn_count > 0 )); then
    echo
    warn "Se detectaron $warn_count advertencia(s). ¿Continuar de todos modos?"
    confirm "Continuar?" || die "Abortado por usuario"
  fi
}

load_queue() {
  QUEUE=()
  [[ -f "$QUEUE_FILE" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if is_valid_json "$line"; then
      QUEUE+=("$line")
    else
      warn "Línea inválida en queue (skip): ${line:0:80}..."
    fi
  done < "$QUEUE_FILE"
}

# Guardar queue (atómico: temp + mv)
save_queue() {
  local tmp
  tmp=$(mktemp "${QUEUE_FILE}.XXXXXX") || die "No se pudo crear temp file"
  printf '%s\n' "${QUEUE[@]}" > "$tmp" && mv "$tmp" "$QUEUE_FILE"
}

trap_cleanup() {
  save_queue
  for dir in "${TEMP_DIRS[@]}"; do
    [[ -d "$dir" ]] && rm -rf "$dir"
  done
  [[ $HAS_TPUT -eq 1 ]] && tput cnorm 2>/dev/null
}

# ──────────────────────────────────────────────────────────────────────
# T2: BUILDERS — Format args y Output templates
# ──────────────────────────────────────────────────────────────────────

# Construye array de argumentos base para yt-dlp según preset
# Retorna: array YTDLP_ARGS (global)
build_format_args() {
  local preset="${1:-$PRESET}"
  local -a args=()

  # Format sorting según preset
  case "$preset" in
    maxima)        args+=(-S "res,br") ;;
    equilibrado)   args+=(-S "res:1080,br") ;;
    compatibilidad) args+=(-S "ext:mp4:m4a,codec:h264:aac,res,br") ;;
    minimo)        args+=(-S "+size,+br") ;;
    av1opus)       args+=(-S "codec:av1:opus,res,br") ;;
    custom)        # Se maneja fuera: usuario pasa su -S
      ;;
    *)             args+=(-S "res,br") ;;
  esac

  # Fallback implícito: bv*+ba/b (default yt-dlp) — NO usamos -f restrictivo
  # Esto permite webm, mkv, mp4, lo que venga

  # Post-procesado SIEMPRE activo
  args+=(
    --embed-metadata
    --embed-thumbnail
    --embed-chapters
    --sponsorblock-mark all
    --sponsorblock-remove "$SPONSORBLOCK_REMOVE"
  )

  # Subtítulos (stub siempre activo; menú interactivo en T6)
  if [[ -n "$SUB_LANGS" ]]; then
    args+=(--write-subs --embed-subs --sub-lang "$SUB_LANGS")
  fi

  # Archive persistente
  args+=(--download-archive "$ARCHIVE_FILE")

  # Red y resiliencia
  args+=(
    --socket-timeout 60
    --retries 20
    --fragment-retries 20
    -N 4
    --concurrent-fragments 4
  )

  # Comportamiento playlist/errores
  args+=(--ignore-errors --no-abort-on-error)

  # Output progreso
  args+=(--newline --progress)

  # Proxy / cookies / rate limit (si configurados)
  [[ -n "$PROXY" ]] && args+=(--proxy "$PROXY")
  [[ -n "$COOKIES_BROWSER" ]] && args+=(--cookies-from-browser "$COOKIES_BROWSER")
  [[ -n "$RATE_LIMIT" ]] && args+=(--throttled-rate "$RATE_LIMIT")

  # Force IPv4 (opcional via config)
  [[ "${FORCE_IPV4:-false}" == "true" ]] && args+=(--force-ipv4)

  # Extractor args para YouTube (opcional via config)
  [[ -n "${YT_PLAYER_CLIENT:-}" ]] && args+=(--extractor-args "youtube:player_client=${YT_PLAYER_CLIENT}")

  # Dry-run
  if [[ "$DRY_RUN" == "true" ]]; then
    args+=(--simulate --print-json)
  fi

  # Exportar como array global
  YTDLP_ARGS=("${args[@]}")
}

# Retorna template de salida según modo
# Uso: template=$(build_output_template "video" "$outdir")
build_output_template() {
  local mode="$1"
  local outdir="${2:-$OUTDIR}"

  case "$mode" in
    video|audio)
      printf '%s/%s' "$outdir" '%(title)s [%(id)s].%(ext)s'
      ;;
    playlist)
      printf '%s/%s' "$outdir" '%(playlist_title)s/%(playlist_index)03d - %(title)s [%(id)s].%(ext)s'
      ;;
    channel)
      printf '%s/%s' "$outdir" '%(uploader)s/%(upload_date>%Y-%m-%d)s - %(title)s [%(id)s].%(ext)s'
      ;;
    custom)
      # Custom: usuario define en ask()
      printf '%s' "$outdir"
      ;;
    *)
      printf '%s/%s' "$outdir" '%(title)s [%(id)s].%(ext)s'
      ;;
  esac
}

