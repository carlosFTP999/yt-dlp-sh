# ──────────────────────────────────────────────────────────────────────
# QUEUE MENU
# ──────────────────────────────────────────────────────────────────────
queue_menu() {
  load_queue
  while true; do
    print_header "COLA DE DESCARGAS (${#QUEUE[@]} items)"
    local choice
    choice=$(choose "Acciones de cola" \
      "add"       "Añadir URL a la cola" \
      "list"      "Listar items pendientes/completados/fallados" \
      "process"   "Procesar cola (secuencial)" \
      "retry"     "Reintentar items fallados" \
      "clear"     "Limpiar cola (solo pendientes)" \
      "back"      "Volver al menú principal")
    case "$choice" in
      add)      queue_add ;;
      list)     queue_list ;;
      process)  queue_process ;;
      retry)    queue_retry ;;
      clear)    queue_clear ;;
      back|*)   return ;;
    esac
  done
}

queue_add() {
  print_header "AÑADIR A COLA"
  local url mode preset
  url=$(ask "URL")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  mode=$(choose "Modo" \
    "video"   "Video único" \
    "audio"   "Solo audio" \
    "playlist" "Playlist" \
    "channel" "Canal" \
    "custom"  "Custom flags")
  preset=$(choose "Preset de calidad" \
    "maxima"       "res,br (mejor calidad nativa)" \
    "equilibrado"  "res:1080,br (cap 1080p)" \
    "compatibilidad" "ext:mp4:m4a,codec:h264:aac,res,br" \
    "minimo"       "+size,+br (menor tamaño)" \
    "av1opus"      "codec:av1:opus,res,br" \
    "custom"       "Escribir -S personalizado")

  local options='{}'
  case "$mode" in
    playlist)
      local start end
      start=$(ask "Video inicial (1 = primero)" "1")
      end=$(ask "Video final (vacío = hasta el final)" "")
      options=$(printf '{"start":"%s","end":"%s"}' "$start" "$end")
      ;;
    custom)
      local extra_flags
      extra_flags=$(ask "Flags extra para yt-dlp" "")
      options=$(printf '{"extra_flags":"%s"}' "$(json_escape "$extra_flags")")
      ;;
  esac

  local id="q_$(date +%s%N)"
  local created=$(date -Iseconds)
  local item
  item=$(json_build_queue_item "$id" "$url" "$mode" "$preset" "$options" "pending" "$created")

  QUEUE+=("$item")
  save_queue
  ok "Añadido a cola (pos ${#QUEUE[@]})"
}

queue_list() {
  print_header "LISTA DE COLA"
  if (( ${#QUEUE[@]} == 0 )); then
    info "Cola vacía"
    return
  fi
  local i=1
  for item in "${QUEUE[@]}"; do
    local id mode preset status
    id=$(json_get "$item" "id" || true)
    mode=$(json_get "$item" "mode" || true)
    preset=$(json_get "$item" "preset" || true)
    status=$(json_get "$item" "status" || true)
    printf "  %2d. [%s] %s | %s | %s\n" "$i" "$status" "$mode" "$preset" "$id"
    i=$((i + 1))
  done
  ask "Presiona Enter para continuar" "" >/dev/null
}

queue_process() {
  print_header "PROCESAR COLA (secuencial)"
  if (( ${#QUEUE[@]} == 0 )); then
    info "Cola vacía"
    return
  fi

  local i=0
  for item in "${QUEUE[@]}"; do
    i=$((i + 1))
    local id status mode preset url options
    id=$(json_get "$item" "id")
    status=$(json_get "$item" "status")
    [[ "$status" != "pending" ]] && continue

    mode=$(json_get "$item" "mode")
    preset=$(json_get "$item" "preset")
    url=$(json_get "$item" "url")
    options=$(json_get_raw "$item" "options")

    # Marcar running
    local started updated_item
    started=$(date -Iseconds)
    updated_item=$(sed "s/\"status\":\"pending\"/\"status\":\"running\",\"started\":\"$started\"/" <<<"$item")
    QUEUE[$((i-1))]="$updated_item"
    save_queue

    info "Procesando $i/${#QUEUE[@]}: $mode ($preset)"
    local exit_code=0

    case "$mode" in
      video)
        build_format_args "$preset"
        template=$(build_output_template "video" "$OUTDIR")
        yt-dlp "${YTDLP_ARGS[@]}" -o "$template" "$url" || exit_code=$?
        ;;
      audio)
        build_format_args "$preset"
        template=$(build_output_template "audio" "$OUTDIR")
        yt-dlp "${YTDLP_ARGS[@]}" -x -o "$template" "$url" || exit_code=$?
        ;;
      playlist)
        build_format_args "$preset"
        template=$(build_output_template "playlist" "$OUTDIR")
        local start end playlist_items
        start=$(json_get "$options" "start")
        end=$(json_get "$options" "end")
        playlist_items="${start:-1}-"
        [[ -n "$end" && "$end" != "null" ]] && playlist_items="${start:-1}-${end}"
        yt-dlp "${YTDLP_ARGS[@]}" --playlist-items "$playlist_items" -o "$template" "$url" || exit_code=$?
        ;;
      channel)
        build_format_args "$preset"
        template=$(build_output_template "channel" "$OUTDIR")
        yt-dlp "${YTDLP_ARGS[@]}" -o "$template" "$url" || exit_code=$?
        ;;
      custom)
        build_format_args "$preset"
        template=$(build_output_template "custom" "$OUTDIR")
        local extra_flags
        extra_flags=$(json_get "$options" "extra_flags")
        local -a extra_arr=()
        [[ -n "$extra_flags" && "$extra_flags" != "null" ]] && extra_arr=($extra_flags)
        yt-dlp "${YTDLP_ARGS[@]}" "${extra_arr[@]}" -o "$template" "$url" || exit_code=$?
        ;;
    esac

    local finished
    finished=$(date -Iseconds)
    if (( exit_code == 0 )); then
      updated_item=$(sed "s/\"status\":\"running\"/\"status\":\"done\",\"finished\":\"$finished\"/" <<<"$updated_item")
      ok "Item $id completado"
    else
      updated_item=$(sed "s/\"status\":\"running\"/\"status\":\"failed\",\"finished\":\"$finished\",\"error\":\"exit code $exit_code\"/" <<<"$updated_item")
      warn "Item $id falló (código $exit_code)"
    fi
    QUEUE[$((i-1))]="$updated_item"
    save_queue
  done
  ok "Cola procesada"
}

queue_retry() {
  local retried=0
  for i in "${!QUEUE[@]}"; do
    local status
    status=$(json_get "${QUEUE[i]}" "status")
    if [[ "$status" == "failed" ]]; then
      local updated
      updated=$(sed 's/"status":"failed"/"status":"pending"/' <<<"${QUEUE[i]}")
      QUEUE[i]="$updated"
      retried=$((retried + 1))
    fi
  done
  if (( retried > 0 )); then
    save_queue
    ok "$retried item(s) marcados para reintento"
  else
    info "No hay items fallados para reintentar"
  fi
}

queue_clear() {
  local pending=0
  for item in "${QUEUE[@]}"; do
    local status
    status=$(json_get "$item" "status")
    if [[ "$status" == "pending" ]]; then pending=$((pending + 1)); fi
  done
  if (( pending == 0 )); then
    info "No hay items pendientes para limpiar"
    return
  fi
  if confirm "¿Limpiar $pending item(s) pendiente(s)?"; then
    local new_queue=()
    for item in "${QUEUE[@]}"; do
      local status
      status=$(json_get "$item" "status")
      [[ "$status" != "pending" ]] && new_queue+=("$item")
    done
    QUEUE=("${new_queue[@]}")
    save_queue
    ok "$pending item(s) pendiente(s) eliminado(s)"
  fi
}

