# ──────────────────────────────────────────────────────────────────────
# QUEUE MENU
# ──────────────────────────────────────────────────────────────────────
queue_menu() {
  load_queue
  while true; do
    print_header "COLA DE DESCARGAS (${#QUEUE[@]} items)"
    local choice
    choice=$(choose "Acciones de cola" \
      "add"      "Añadir URL a la cola" \
      "list"     "Listar items pendientes/completados/fallados" \
      "process"  "Procesar cola (secuencial)" \
      "clear"    "Limpiar cola (solo pendientes)" \
      "back"     "Volver al menú principal")
    case "$choice" in
      add)    queue_add ;;
      list)   queue_list ;;
      process) queue_process ;;
      clear)  queue_clear ;;
      back|*) return ;;
    esac
  done
}

queue_add() {
  print_header "AÑADIR A COLA"
  local url mode preset
  url=$(ask "URL")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  mode=$(choose "Modo" \
    "video"   "Video único" \
    "audio"   "Solo audio" \
    "playlist" "Playlist" \
    "channel" "Canal" \
    "custom"  "Custom flags")
  preset=$(choose "Preset de calidad" \
    "maxima"       "res,br (mejor calidad nativa)" \
    "equilibrado"  "res:1080,br (cap 1080p)" \
    "compatibilidad" "ext:mp4:m4a,codec:h264:aac,res,br" \
    "minimo"       "+size,+br (menor tamaño)" \
    "av1opus"      "codec:av1:opus,res,br" \
    "custom"       "Escribir -S personalizado")

  local item
  item=$(printf '{"id":"q_%s","url":"%s","mode":"%s","preset":"%s","status":"pending"}' \
    "$(date +%s%N)" "$url" "$mode" "$preset")
  QUEUE+=("$item")
  save_queue
  ok "Añadido a cola (pos ${#QUEUE[@]})"
}

queue_list() {
  print_header "LISTA DE COLA"
  if (( ${#QUEUE[@]} == 0 )); then
    info "Cola vacía"
    return
  fi
  local i=1
  for item in "${QUEUE[@]}"; do
    local id mode preset status
    id=$(echo "$item" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
    mode=$(echo "$item" | sed -n 's/.*"mode":"\([^"]*\)".*/\1/p')
    preset=$(echo "$item" | sed -n 's/.*"preset":"\([^"]*\)".*/\1/p')
    status=$(echo "$item" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    printf "  %2d. [%s] %s | %s | %s\n" "$i" "$status" "$mode" "$preset" "$id"
    ((i++))
  done
  ask "Presiona Enter para continuar" "" >/dev/null
}

queue_process() {
  print_header "PROCESAR COLA (secuencial)"
  if (( ${#QUEUE[@]} == 0 )); then
    info "Cola vacía"
    return
  fi
  warn "T7 implementará procesamiento real con yt-dlp"
  info "Por ahora: simulación"
  for item in "${QUEUE[@]}"; do
    local id mode
    id=$(echo "$item" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
    mode=$(echo "$item" | sed -n 's/.*"mode":"\([^"]*\)".*/\1/p')
    printf "  → Procesando %s (%s)...\n" "$id" "$mode"
    sleep 0.5
  done
  ok "Cola procesada (simulación)"
  ask "Presiona Enter para continuar" "" >/dev/null
}

queue_clear() {
  if confirm "¿Limpiar TODOS los items pendientes?"; then
    QUEUE=()
    save_queue
    ok "Cola limpiada"
  fi
}

