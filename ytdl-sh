#!/usr/bin/env bash
# ytdl-sh — Interactive yt-dlp + ffmpeg downloader (single file, zero deps)
# Fase 1: Core sólido — T1: Menú principal + 5 modos + UI
set -euo pipefail
IFS=$'\n\t'

# ──────────────────────────────────────────────────────────────────────
# CONSTANTES Y DEFAULTS
# ──────────────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="ytdl-sh"
readonly VERSION="1.0.0-core"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ytdl-sh"
readonly ARCHIVE_FILE="$CONFIG_DIR/archive.txt"
readonly HISTORY_FILE="$CONFIG_DIR/history.jsonl"
readonly QUEUE_FILE="$CONFIG_DIR/queue.jsonl"
readonly CONFIG_FILE="$CONFIG_DIR/config"

# Defaults (pueden sobreescribirse por config file)
OUTDIR="${OUTDIR:-$HOME/Descargas}"
PRESET="${PRESET:-maxima}"
PARALLEL="${PARALLEL:-1}"
SUB_LANGS="${SUB_LANGS:-es,en}"
SPONSORBLOCK_REMOVE="${SPONSORBLOCK_REMOVE:-sponsor,selfpromo,interaction}"
PROXY="${PROXY:-}"
COOKIES_BROWSER="${COOKIES_BROWSER:-}"
RATE_LIMIT="${RATE_LIMIT:-}"
FORCE_IPV4="${FORCE_IPV4:-false}"
YT_PLAYER_CLIENT="${YT_PLAYER_CLIENT:-}"
NOTIFY_CMD="${NOTIFY_CMD:-}"

# Dry-run flag (T2)
DRY_RUN="${DRY_RUN:-false}"

# Config defaults map (para load/save/reset)
declare -A CONFIG_DEFAULTS=(
  [OUTDIR]="$HOME/Descargas"
  [PRESET]="maxima"
  [PARALLEL]="1"
  [SUB_LANGS]="es,en"
  [SPONSORBLOCK_REMOVE]="sponsor,selfpromo,interaction"
  [PROXY]=""
  [COOKIES_BROWSER]=""
  [RATE_LIMIT]=""
  [FORCE_IPV4]="false"
  [YT_PLAYER_CLIENT]=""
  [NOTIFY_CMD]=""
)

# ──────────────────────────────────────────────────────────────────────
# UI HELPERS — Pure bash ANSI (cero deps)
# ──────────────────────────────────────────────────────────────────────

# Detectar capacidades de terminal
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  readonly HAS_TPUT=1
  readonly BOLD="$(tput bold 2>/dev/null || echo '')"
  readonly DIM="$(tput dim 2>/dev/null || echo '')"
  readonly RED="$(tput setaf 1 2>/dev/null || echo '')"
  readonly GREEN="$(tput setaf 2 2>/dev/null || echo '')"
  readonly YELLOW="$(tput setaf 3 2>/dev/null || echo '')"
  readonly BLUE="$(tput setaf 4 2>/dev/null || echo '')"
  readonly CYAN="$(tput setaf 6 2>/dev/null || echo '')"
  readonly RESET="$(tput sgr0 2>/dev/null || echo '')"
  readonly CLEAR_LINE="$(tput el 2>/dev/null || echo '')"
else
  readonly HAS_TPUT=0
  readonly BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" CYAN="" RESET="" CLEAR_LINE=""
fi

# Helpers de salida
die() { printf "%b\n" "${RED}✘${RESET} $*" >&2; exit 1; }
ok()   { printf "%b\n" "${GREEN}✔${RESET} $*"; }
info() { printf "%b\n" "${BLUE}ℹ${RESET} $*"; }
warn() { printf "%b\n" "${YELLOW}⚠${RESET} $*"; }
dim()  { printf "%b\n" "${DIM}$*${RESET}"; }

# Header visual
print_header() {
  local title="$1"
  local width=60
  printf "\n%b%*s%b\n" "${BOLD}${CYAN}" "$width" "" "${RESET}"
  printf "%b %-*s %b\n" "${BOLD}${CYAN}" "$((width - 2))" "$title" "${RESET}"
  printf "%b%*s%b\n\n" "${BOLD}${CYAN}" "$width" "" "${RESET}"
}

# Menú navegable con flechas (ANSI)
# Uso: choose "Prompt" "opt1" "desc1" "opt2" "desc2" ...
# Retorna: option seleccionada (stdout)
choose() {
  local prompt="$1"; shift
  local -a opts=("$@")
  local -i n_choices=$(( ${#opts[@]} / 2 ))
  local -i sel=0
  local key

  # Ocultar cursor
  [[ $HAS_TPUT -eq 1 ]] && tput civis 2>/dev/null

  while true; do
    clear
    print_header "$prompt"
    for ((i=0; i<${#opts[@]}; i+=2)); do
      local idx=$((i/2))
      if (( idx == sel )); then
        printf "  ${CYAN}▸ %s${RESET} — %s\n" "${opts[i]}" "${opts[i+1]}"
      else
        printf "    %s — %s\n" "${opts[i]}" "${opts[i+1]}"
      fi
    done
    printf "\n  ${DIM}↑/↓ navegar · Enter seleccionar · Esc cancelar${RESET}\n"

    IFS= read -rsn1 key
    case "$key" in
      $'\x1b')
        # Leer siguiente byte para distinguir ESC solo vs secuencia
        IFS= read -rsn1 -t 0.001 key2
        if [[ -z "$key2" ]]; then
          # ESC presionado solo → cancelar
          [[ $HAS_TPUT -eq 1 ]] && tput cnorm 2>/dev/null
          return 1
        fi
        IFS= read -rsn1 -t 0.001 key3
        case "${key2}${key3}" in
          '[A') (( sel > 0 )) && ((sel--)) ;;
          '[B') (( sel < n_choices - 1 )) && ((sel++)) ;;
        esac
        ;;
      '') # Enter
        [[ $HAS_TPUT -eq 1 ]] && tput cnorm 2>/dev/null
        printf '%s' "${opts[sel*2]}"
        return 0
        ;;
      $'\x03') # Ctrl+C
        [[ $HAS_TPUT -eq 1 ]] && tput cnorm 2>/dev/null
        die "Cancelado por usuario"
        ;;
    esac
  done
}

# Input libre con prompt
# Uso: ask "Prompt" [default]
# Retorna: input (stdout)
ask() {
  local prompt="$1"
  local default="${2:-}"
  local input

  if [[ -n "$default" ]]; then
    read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[$default]${RESET} ")" input
    printf '%s' "${input:-$default}"
  else
    read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ")" input
    printf '%s' "$input"
  fi
}

# Confirmación sí/no
# Uso: confirm "Prompt" [default_y/n]
# Retorna: 0=sí, 1=no
confirm() {
  local prompt="$1"
  local default="${2:-y}"
  local yn

  while true; do
    if [[ "$default" == "y" ]]; then
      read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[Y/n]${RESET} ")" yn
      yn="${yn:-y}"
    else
      read -rp "$(printf "%b" "${BLUE}?${RESET} $prompt ${DIM}[y/N]${RESET} ")" yn
      yn="${yn:-n}"
    fi
    case "${yn,,}" in
      y|yes|s|si|sí) return 0 ;;
      n|no) return 1 ;;
      *) warn "Respuesta inválida: y/sí o n/no" ;;
    esac
  done
}

# ──────────────────────────────────────────────────────────────────────
# STUBS — Para ser implementados en T4, T6, T7
# ──────────────────────────────────────────────────────────────────────

init_config_dirs() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$CONFIG_FILE" ]] || touch "$CONFIG_FILE"
  [[ -f "$ARCHIVE_FILE" ]] || touch "$ARCHIVE_FILE"
  [[ -f "$HISTORY_FILE" ]] || touch "$HISTORY_FILE"
  [[ -f "$QUEUE_FILE" ]] || touch "$QUEUE_FILE"
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    [[ -z "$key" ]] && continue
    [[ "$key" =~ ^# ]] && continue  # comentarios
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue  # validar key
    # Solo keys conocidas en CONFIG_DEFAULTS
    [[ -v CONFIG_DEFAULTS["$key"] ]] || continue
    # Exportar para subprocessos
    export "$key"="$value"
    # Setear variable global (indirect expansion)
    printf -v "$key" '%s' "$value"
  done < "$CONFIG_FILE"
}

# Guardar config (atómico: temp + mv)
save_config() {
  local tmp
  tmp=$(mktemp "${CONFIG_FILE}.XXXXXX") || die "No se pudo crear temp file"
  {
    echo "# ytdl-sh config — $(date -Iseconds)"
    for key in "${!CONFIG_DEFAULTS[@]}"; do
      local val="${!key}"  # indirect expansion
      printf '%s=%s\n' "$key" "$val"
    done
  } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  ok "Configuración guardada en $CONFIG_FILE"
}

# ──────────────────────────────────────────────────────────────────────
# T7: JSONL HELPERS — Pure bash JSON parsing (sin jq)
# ──────────────────────────────────────────────────────────────────────

# Escapar string para JSON (básico: \, ", newline, tab, carriage return)
json_escape() {
  local str="$1"
  str="${str//\\/\\\\}"  # \ → \\
  str="${str//\"/\\\"}"  # " → \"
  str="${str//$'\n'/\\n}" # newline → \n
  str="${str//$'\t'/\\t}" # tab → \t
  str="${str//$'\r'/\\r}" # carriage return → \r
  printf '%s' "$str"
}

# Validar línea JSONL básica (sin jq)
# Retorna 0 si parece JSON válido, 1 si no
is_valid_json() {
  local line="$1"
  [[ -z "$line" ]] && return 1
  # Debe empezar con { y terminar con }
  [[ "$line" =~ ^\{.*\}$ ]] || return 1
  # Llaves balanceadas (básico)
  local open close
  open=$(grep -o '{' <<<"$line" | wc -l)
  close=$(grep -o '}' <<<"$line" | wc -l)
  (( open == close )) || return 1
  # Comillas balanceadas (aprox)
  local quotes
  quotes=$(grep -o '"' <<<"$line" | wc -l)
  (( quotes % 2 == 0 )) || return 1
  return 0
}

# Extraer valor de campo simple (string) de JSON
# Uso: json_get "$line" "id"
json_get() {
  local json="$1"
  local key="$2"
  # Busca "key":"value" o "key": "value" (escapa comillas en value)
  local val
  val=$(sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" <<<"$json")
  printf '%s' "$val"
}

# Extraer valor de campo que puede ser string, number, bool, null, object
# Retorna el valor raw (sin comillas si es string)
json_get_raw() {
  local json="$1"
  local key="$2"
  # Captura todo entre : y , o } (incluye strings, numbers, true, false, null, objects)
  local val
  val=$(sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p" <<<"$json" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  printf '%s' "$val"
}

# Construir JSON para queue item
# Uso: json_build_queue_item "id" "url" "mode" "preset" '{"start":"1","end":"50"}' "status" "created" ["started"] ["finished"] ["error"]
json_build_queue_item() {
  local id="$1" url="$2" mode="$3" preset="$4" options="$5" status="$6" created="$7" started="${8:-}" finished="${9:-}" error="${10:-}"
  local item
  item=$(printf '{"id":"%s","url":"%s","mode":"%s","preset":"%s","options":%s,"status":"%s"' \
    "$(json_escape "$id")" \
    "$(json_escape "$url")" \
    "$(json_escape "$mode")" \
    "$(json_escape "$preset")" \
    "$options" \
    "$(json_escape "$status")")
  [[ -n "$created" ]] && item="${item},\"created\":\"$(json_escape "$created")\""
  [[ -n "$started" ]] && item="${item},\"started\":\"$(json_escape "$started")\""
  [[ -n "$finished" ]] && item="${item},\"finished\":\"$(json_escape "$finished")\""
  [[ -n "$error" ]] && item="${item},\"error\":\"$(json_escape "$error")\""
  item="${item}}"
  printf '%s' "$item"
}

# Array para temp dirs (cleanup en trap)
TEMP_DIRS=()

# Registrar temp dir para cleanup automático
register_temp_dir() {
  TEMP_DIRS+=("$1")
}

# ──────────────────────────────────────────────────────────────────────
# CHECK DEPENDENCIES
# ──────────────────────────────────────────────────────────────────────

check_dependencies() {
  # yt-dlp
  command -v yt-dlp >/dev/null || die "yt-dlp no encontrado. Instala: pipx install yt-dlp / brew install yt-dlp / apt install yt-dlp"
  local ytdlp_ver
  ytdlp_ver=$(yt-dlp --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  [[ -n "$ytdlp_ver" ]] || die "No se pudo obtener versión de yt-dlp"
  # Comparar versión ≥ 2023.01 (año ≥ 2023)
  local year="${ytdlp_ver%%.*}"
  (( year >= 2023 )) || warn "yt-dlp versión $ytdlp_ver — se recomienda ≥ 2023.01 para -S"

  # ffmpeg
  command -v ffmpeg >/dev/null || die "ffmpeg no encontrado. Instala: apt install ffmpeg / brew install ffmpeg"
  local ffmpeg_ver
  ffmpeg_ver=$(ffmpeg -version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
  [[ -n "$ffmpeg_ver" ]] || warn "No se pudo obtener versión de ffmpeg"

  # curl
  command -v curl >/dev/null || die "curl no encontrado. Necesario para validación de red"

  ok "Dependencias OK: yt-dlp $ytdlp_ver, ffmpeg $ffmpeg_ver"
}

# ──────────────────────────────────────────────────────────────────────
# T3: PREFLIGHT CHECKS — Validación real de red y disco
# ──────────────────────────────────────────────────────────────────────

preflight_checks() {
  local warn_count=0

  # YouTube
  if timeout 3 curl -sI "https://www.youtube.com" >/dev/null 2>&1; then
    ok "YouTube accesible"
  else
    warn "YouTube NO accesible — ¿red/proxy?"
    ((warn_count++))
  fi

  # googlevideo (CDN de video) — CRÍTICO para descargas
  if timeout 3 curl -sI "https://googlevideo.com" >/dev/null 2>&1; then
    ok "googlevideo (CDN) accesible"
  else
    warn "googlevideo NO accesible — las descargas FALLARÁN. ¿Proxy corporativo? Prueba VPN o --proxy"
    ((warn_count++))
  fi

  # Espacio disco
  local avail_kb
  avail_kb=$(df --output=avail "$OUTDIR" 2>/dev/null | tail -1 | tr -d ' ')
  if [[ -n "$avail_kb" && "$avail_kb" -lt 1048576 ]]; then  # < 1GB en KB
    warn "Espacio en disco < 1GB en $OUTDIR (${avail_kb}KB disponibles)"
    ((warn_count++))
  fi

  if (( warn_count > 0 )); then
    echo
    warn "Se detectaron $warn_count advertencia(s). ¿Continuar de todos modos?"
    confirm "Continuar?" || die "Abortado por usuario"
  fi
}

load_queue() {
  QUEUE=()
  [[ -f "$QUEUE_FILE" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if is_valid_json "$line"; then
      QUEUE+=("$line")
    else
      warn "Línea inválida en queue (skip): ${line:0:80}..."
    fi
  done < "$QUEUE_FILE"
}

# Guardar queue (atómico: temp + mv)
save_queue() {
  local tmp
  tmp=$(mktemp "${QUEUE_FILE}.XXXXXX") || die "No se pudo crear temp file"
  printf '%s\n' "${QUEUE[@]}" > "$tmp" && mv "$tmp" "$QUEUE_FILE"
}

trap_cleanup() {
  save_queue
  for dir in "${TEMP_DIRS[@]}"; do
    [[ -d "$dir" ]] && rm -rf "$dir"
  done
  [[ $HAS_TPUT -eq 1 ]] && tput cnorm 2>/dev/null
}

# ──────────────────────────────────────────────────────────────────────
# T2: BUILDERS — Format args y Output templates
# ──────────────────────────────────────────────────────────────────────

# Construye array de argumentos base para yt-dlp según preset
# Retorna: array YTDLP_ARGS (global)
build_format_args() {
  local preset="${1:-$PRESET}"
  local -a args=()

  # Format sorting según preset
  case "$preset" in
    maxima)        args+=(-S "res,br") ;;
    equilibrado)   args+=(-S "res:1080,br") ;;
    compatibilidad) args+=(-S "ext:mp4:m4a,codec:h264:aac,res,br") ;;
    minimo)        args+=(-S "+size,+br") ;;
    av1opus)       args+=(-S "codec:av1:opus,res,br") ;;
    custom)        # Se maneja fuera: usuario pasa su -S
      ;;
    *)             args+=(-S "res,br") ;;
  esac

  # Fallback implícito: bv*+ba/b (default yt-dlp) — NO usamos -f restrictivo
  # Esto permite webm, mkv, mp4, lo que venga

  # Post-procesado SIEMPRE activo
  args+=(
    --embed-metadata
    --embed-thumbnail
    --embed-chapters
    --sponsorblock-mark all
    --sponsorblock-remove "$SPONSORBLOCK_REMOVE"
  )

  # Subtítulos (stub siempre activo; menú interactivo en T6)
  if [[ -n "$SUB_LANGS" ]]; then
    args+=(--write-subs --embed-subs --sub-lang "$SUB_LANGS")
  fi

  # Archive persistente
  args+=(--download-archive "$ARCHIVE_FILE")

  # Red y resiliencia
  args+=(
    --socket-timeout 60
    --retries 20
    --fragment-retries 20
    -N 4
    --concurrent-fragments 4
  )

  # Comportamiento playlist/errores
  args+=(--ignore-errors --no-abort-on-error)

  # Output progreso
  args+=(--newline --progress)

  # Proxy / cookies / rate limit (si configurados)
  [[ -n "$PROXY" ]] && args+=(--proxy "$PROXY")
  [[ -n "$COOKIES_BROWSER" ]] && args+=(--cookies-from-browser "$COOKIES_BROWSER")
  [[ -n "$RATE_LIMIT" ]] && args+=(--throttled-rate "$RATE_LIMIT")

  # Force IPv4 (opcional via config)
  [[ "${FORCE_IPV4:-false}" == "true" ]] && args+=(--force-ipv4)

  # Extractor args para YouTube (opcional via config)
  [[ -n "${YT_PLAYER_CLIENT:-}" ]] && args+=(--extractor-args "youtube:player_client=${YT_PLAYER_CLIENT}")

  # Dry-run
  if [[ "$DRY_RUN" == "true" ]]; then
    args+=(--simulate --print-json)
  fi

  # Exportar como array global
  YTDLP_ARGS=("${args[@]}")
}

# Retorna template de salida según modo
# Uso: template=$(build_output_template "video" "$outdir")
build_output_template() {
  local mode="$1"
  local outdir="${2:-$OUTDIR}"

  case "$mode" in
    video|audio)
      printf '%s/%s' "$outdir" '%(title)s [%(id)s].%(ext)s'
      ;;
    playlist)
      printf '%s/%s' "$outdir" '%(playlist_title)s/%(playlist_index)03d - %(title)s [%(id)s].%(ext)s'
      ;;
    channel)
      printf '%s/%s' "$outdir" '%(uploader)s/%(upload_date>%Y-%m-%d)s - %(title)s [%(id)s].%(ext)s'
      ;;
    custom)
      # Custom: usuario define en ask()
      printf '%s' "$outdir"
      ;;
    *)
      printf '%s/%s' "$outdir" '%(title)s [%(id)s].%(ext)s'
      ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────
# MODO: VIDEO
# ──────────────────────────────────────────────────────────────────────
mode_video() {
  print_header "MODO VIDEO — Video único (mejor calidad nativa)"
  local url
  url=$(ask "URL del video")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  local outdir
  outdir=$(ask "Directorio de salida" "$OUTDIR")

  # Confirmación con resumen
  print_header "CONFIRMACIÓN — Video"
  printf "  URL:        %s\n" "$url"
  printf "  Salida:     %s\n" "$outdir"
  printf "  Preset:     %s (-S \"res,br\")\n" "$PRESET"
  printf "  Formato:    Contenedor original (webm/mkv/mp4...)\n"
  printf "  Subs:       %s (embed)\n" "$SUB_LANGS"
  printf "  SponsorBlock: mark all + remove %s\n" "$SPONSORBLOCK_REMOVE"
  printf "  Archive:    ✓\n"
  echo

  if ! confirm "¿Ejecutar descarga?"; then
    info "Cancelado"
    return 0
  fi

  # Construir args y ejecutar
  build_format_args "$PRESET"
  local template
  template=$(build_output_template "video" "$outdir")

  info "Iniciando descarga con yt-dlp..."
  yt-dlp "${YTDLP_ARGS[@]}" -o "$template" "$url"
  local exit_code=$?

  if (( exit_code == 0 )); then
    ok "Descarga completada"
  else
    warn "yt-dlp terminó con código $exit_code"
  fi
}

# ──────────────────────────────────────────────────────────────────────
# MODO: AUDIO
# ──────────────────────────────────────────────────────────────────────
mode_audio() {
  print_header "MODO AUDIO — Solo audio (mejor calidad original)"
  local url
  url=$(ask "URL del video")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  local outdir
  outdir=$(ask "Directorio de salida" "$OUTDIR")

  print_header "CONFIRMACIÓN — Audio"
  printf "  URL:        %s\n" "$url"
  printf "  Salida:     %s\n" "$outdir"
  printf "  Formato:    Original (opus/m4a/webm/flac...) — sin reconversión\n"
  printf "  Archive:    ✓\n"
  echo

  if ! confirm "¿Ejecutar descarga?"; then
    info "Cancelado"
    return 0
  fi

  build_format_args "$PRESET"
  local template
  template=$(build_output_template "audio" "$outdir")

  info "Iniciando extracción de audio con yt-dlp..."
  # -x extrae audio SIN --audio-format → mantiene contenedor original (opus/m4a/webm/flac)
  yt-dlp "${YTDLP_ARGS[@]}" -x -o "$template" "$url"
  local exit_code=$?

  if (( exit_code == 0 )); then
    ok "Extracción de audio completada"
  else
    warn "yt-dlp terminó con código $exit_code"
  fi
}

# ──────────────────────────────────────────────────────────────────────
# MODO: PLAYLIST
# ──────────────────────────────────────────────────────────────────────
mode_playlist() {
  print_header "MODO PLAYLIST — Lista completa o rango"
  local url
  url=$(ask "URL de la playlist")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  local start end
  start=$(ask "Video inicial (1 = primero)" "1")
  end=$(ask "Video final (vacío = hasta el final)" "")

  local outdir
  outdir=$(ask "Directorio base de salida" "$OUTDIR")

  print_header "CONFIRMACIÓN — Playlist"
  printf "  URL:        %s\n" "$url"
  printf "  Rango:      %s-%s\n" "$start" "${end:-fin}"
  printf "  Salida:     %s/<playlist_title>/\n" "$outdir"
  printf "  Template:   %%(playlist_index)03d - %%(title)s [%%(id)s].%%(ext)s\n"
  printf "  Preset:     %s\n" "$PRESET"
  printf "  Subs:       %s (embed)\n" "$SUB_LANGS"
  printf "  Archive:    ✓\n"
  echo

  if ! confirm "¿Ejecutar descarga?"; then
    info "Cancelado"
    return 0
  fi

  build_format_args "$PRESET"
  local template
  template=$(build_output_template "playlist" "$outdir")

  # Construir --playlist-items
  local playlist_items="${start}-"
  [[ -n "$end" ]] && playlist_items="${start}-${end}"

  info "Iniciando descarga de playlist con yt-dlp..."
  yt-dlp "${YTDLP_ARGS[@]}" --playlist-items "$playlist_items" -o "$template" "$url"
  local exit_code=$?

  if (( exit_code == 0 )); then
    ok "Playlist completada"
  else
    warn "yt-dlp terminó con código $exit_code"
  fi
}

# ──────────────────────────────────────────────────────────────────────
# MODO: CANAL
# ──────────────────────────────────────────────────────────────────────
mode_channel() {
  print_header "MODO CANAL — Canal completo (videos + shorts + lives)"
  local url
  url=$(ask "URL del canal (@handle o /c/ o /channel/)")
  [[ -z "$url" ]] && { warn "URL vacía"; return 1; }

  local outdir
  outdir=$(ask "Directorio base de salida" "$OUTDIR")

  print_header "CONFIRMACIÓN — Canal"
  printf "  URL:        %s\n" "$url"
  printf "  Salida:     %s/<uploader>/%%(upload_date>%%Y-%%m-%%d)s - %%(title)s [%%(id)s].%%(ext)s\n" "$outdir"
  printf "  Preset:     %s\n" "$PRESET"
  printf "  Archive:    ✓\n"
  echo

  if ! confirm "¿Ejecutar descarga?"; then
    info "Cancelado"
    return 0
  fi

  build_format_args "$PRESET"
  local template
  template=$(build_output_template "channel" "$outdir")

  info "Iniciando descarga de canal con yt-dlp..."
  yt-dlp "${YTDLP_ARGS[@]}" -o "$template" "$url"
  local exit_code=$?

  if (( exit_code == 0 )); then
    ok "Canal completado"
  else
    warn "yt-dlp terminó con código $exit_code"
  fi
}

