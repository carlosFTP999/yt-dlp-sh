# Dry-run flag (T2)
DRY_RUN="${DRY_RUN:-false}"

# Config defaults map (para load/save/reset)
declare -A CONFIG_DEFAULTS=(
  [OUTDIR]="$HOME/Descargas"
  [PRESET]="maxima"
  [PARALLEL]="1"
  [SUB_LANGS]="es,en"
  [SPONSORBLOCK_REMOVE]="sponsor,selfpromo,interaction"
  [PROXY]=""
