# ──────────────────────────────────────────────────────────────────────
# ENTRY POINT
# ──────────────────────────────────────────────────────────────────────
main() {
  # Parsear flags globales
  while (( $# > 0 )); do
    case "$1" in
      -n|--dry-run)
        DRY_RUN=true
        shift
        ;;
      -h|--help)
        help_screen
        exit 0
        ;;
      -v|--version)
        printf "%s v%s\n" "$SCRIPT_NAME" "$VERSION"
        exit 0
        ;;
      *)
        # Ignorar flags desconocidos (para futuras extensiones)
        shift
        ;;
    esac
  done

  # Inicialización básica
  init_config_dirs
  load_config
  check_dependencies
  preflight_checks

  # Traps (T7 implementará cleanup real)
  trap 'trap_cleanup; exit 130' INT
  trap 'trap_cleanup; exit 143' TERM

  # Ejecutar menú principal
  main_menu

  # Limpieza final
  trap_cleanup
  printf "\n%b¡Hasta la próxima!%b\n" "${GREEN}" "${RESET}"
}

