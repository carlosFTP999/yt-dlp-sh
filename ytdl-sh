check_dependencies() {
  # yt-dlp
  command -v yt-dlp >/dev/null || die "yt-dlp no encontrado. Instala: pipx install yt-dlp / brew install yt-dlp / apt install yt-dlp"
  local ytdlp_ver
  ytdlp_ver=$(yt-dlp --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1) || ytdlp_ver=""
  [[ -n "$ytdlp_ver" ]] || die "No se pudo obtener versión de yt-dlp"
  # Comparar versión ≥ 2023.01 (año ≥ 2023)
  local year="${ytdlp_ver%%.*}"
  (( year >= 2023 )) || warn "yt-dlp versión $ytdlp_ver — se recomienda ≥ 2023.01 para -S"

  # ffmpeg
  command -v ffmpeg >/dev/null || die "ffmpeg no encontrado. Instala: apt install ffmpeg / brew install ffmpeg"
  local ffmpeg_ver
  ffmpeg_ver=$(ffmpeg -version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1) || ffmpeg_ver=""
  [[ -n "$ffmpeg_ver" ]] || warn "No se pudo obtener versión de ffmpeg"

  # curl
  command -v curl >/dev/null || die "curl no encontrado. Necesario para validación de red"

  ok "Dependencias OK: yt-dlp $ytdlp_ver, ffmpeg $ffmpeg_ver"
}

