  yt-dlp + ffmpeg requeridos en PATH
  bash 4.4+ recomendado (macOS: brew install bash)

EOF
  ask "Presiona Enter para volver" "" >/dev/null
}

# ──────────────────────────────────────────────────────────────────────
# MAIN MENU
# ──────────────────────────────────────────────────────────────────────
main_menu() {
  while true; do
    clear
    print_header "$SCRIPT_NAME v$VERSION"
    dim "Interactive yt-dlp + ffmpeg downloader — cero dependencias"

    local choice
    choice=$(choose "Selecciona modo" \
      "video"    "Video único (mejor calidad nativa)" \
      "audio"    "Solo audio (mejor calidad original)" \
      "playlist" "Playlist completa o rango N-M" \
      "channel"  "Canal completo (videos + shorts + lives)" \
      "custom"   "URL + flags manuales de yt-dlp" \
      "queue"    "Cola de descargas (añadir/listar/procesar)" \
      "settings" "Ajustes y configuración" \
      "help"     "Ayuda y atajos" \
      "exit"     "Salir")

    case "$choice" in
      video)    mode_video ;;
      audio)    mode_audio ;;
      playlist) mode_playlist ;;
      channel)  mode_channel ;;
      custom)   mode_custom ;;
      queue)    queue_menu ;;
      settings) settings_menu ;;
      help)     help_screen ;;
      exit)     return 0 ;;
    esac
  done
}

# ──────────────────────────────────────────────────────────────────────
# ENTRY POINT
# ──────────────────────────────────────────────────────────────────────
main() {
  # Parsear flags globales
  while (( $# > 0 )); do
    case "$1" in
      -n|--dry-run)
        DRY_RUN=true
        shift
        ;;
      -h|--help)
        help_screen
        exit 0
        ;;
      -v|--version)
        printf "%s v%s\n" "$SCRIPT_NAME" "$VERSION"
        exit 0
        ;;
      *)
        # Ignorar flags desconocidos (para futuras extensiones)
        shift
        ;;
    esac
  done

  # Inicialización básica
  init_config_dirs
  load_config
  check_dependencies
  preflight_checks

  # Traps (T7 implementará cleanup real)
  trap 'trap_cleanup; exit 130' INT
  trap 'trap_cleanup; exit 143' TERM

  # Ejecutar menú principal
  main_menu

  # Limpieza final
  trap_cleanup
  printf "\n%b¡Hasta la próxima!%b\n" "${GREEN}" "${RESET}"
}

# Ejecutar si no está siendo sourceado
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi